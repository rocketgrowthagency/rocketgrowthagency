[
 [
  "the chat copy becomes a mirror",
  "backuplacie",
  "rsync -a --exclude '.DS_Store' \"$CHATS_SRC/\" \"$dest/\"",
  "rsync -a --delete --exclude '.DS_Store' \"$CHATS_SRC/\" \"$dest/\"",
  1
 ],
 [
  "chats don't get copied",
  "backuplacie",
  "rsync -a --exclude '.DS_Store' \"$CHATS_SRC/\" \"$dest/\" || problem",
  "true || problem",
  1
 ],
 [
  "a .env reaches the drive",
  "backuplacie",
  " --exclude '.env*'",
  "",
  1
 ],
 [
  "node_modules gets copied",
  "backuplacie",
  " --exclude 'node_modules'",
  "",
  1
 ],
 [
  "no git bundle is made",
  "backuplacie",
  "    mv \"$bundle.tmp\" \"$bundle\"\n",
  "    rm -f \"$bundle.tmp\"\n",
  1
 ],
 [
  "repo files aren't copied",
  "backuplacie",
  "--exclude '*.pem' --exclude 'id_rsa*' --exclude 'id_ed25519*' \"$src/\" \"$dest/\"",
  "--exclude '*.pem' --exclude 'id_rsa*' --exclude 'id_ed25519*' \"$src/.none/\" \"$dest/\"",
  1
 ],
 [
  "a missing drive goes quiet",
  "backuplacie",
  "  [ \"${#problems[@]}\" -gt 0 ] || problem \"LaCie isn't connected: chats copied to the Mac only, nothing else backed up\"",
  "  :",
  1
 ],
 [
  "a missing repo goes quiet",
  "backuplacie",
  "[ -d \"$src/.git\" ] || { problem \"$name: no repo at $src\"; return; }",
