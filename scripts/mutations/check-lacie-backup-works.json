  1
 ],
 [
  "the script always exits 0",
  "backuplacie",
  "  note \"finished with ${#problems[@]} problem(s)\"\n  exit 1",
  "  note \"finished with ${#problems[@]} problem(s)\"\n  exit 0",
  1
 ],
 [
  "a failure records ok",
  "backuplacie",
  "local ok=true; [ \"${#problems[@]}\" -gt 0 ] && ok=false",
  "local ok=true",
  1
 ],
 [
  "the Mac copy is skipped",
  "backuplacie",
